ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://connextionz:change-me@localhost:5432/connextionz
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=604800
REQUIRE_HTTPS=true
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com
AWS_S3_BUCKET=connextionz-media-production
AWS_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
# AWS credentials should come from an IAM role, profile, or secret manager.
